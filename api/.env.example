# Copy to .env for local development.

# The API reference at /scalar — and the document it reads at /doc — is served
# only for "development" and "test". Every other value, including leaving this
# unset, hides it, so the full API surface stays private by default.
# Read at call time; see `docsEnabled()` in src/helpers/config.ts.
#
# Local development only: do not copy this line into a deployment, where
# "development" is exactly what would publish the API.
NODE_ENV=development

# SQLite file, relative to api/.
DATABASE_URL="file:./prisma/dev.db"

# Integration tests run against a real database of their own, never the dev one.
# Point this anywhere; the file is rebuilt from the migrations on every test run.
TEST_DATABASE_URL="file:./prisma/test.db"

# Signs the session cookie. Generate your own — the app refuses to start without
# one, so that a forgotten secret cannot silently make sessions forgeable.
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""

# A confirmed booking can be cancelled (with refund) until this many days before
# the class starts. Read at call time, so tests can exercise both sides.
CANCELLATION_CUTOFF_DAYS=5

# How long a parent's seat selection is held before it lapses and the seats go
# back on the board. Read at call time — set it to 1 to watch the timer and
# `npm run sweep` work in a demo.
BOOKING_HOLD_MINUTES=15
