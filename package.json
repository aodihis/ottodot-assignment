{
  "name": "ottodot-trial-booking",
  "private": true,
  "type": "module",
  "workspaces": [
    "api",
    "web"
  ],
  "scripts": {
    "dev": "concurrently --names api,web --prefix-colors blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --workspace api run dev",
    "dev:web": "npm --workspace web run dev",
    "build": "npm --workspace web run build",
    "reset": "npm --workspace api run reset",
    "seed": "npm --workspace api run seed",
    "migrate": "npm --workspace api run migrate",
    "sweep": "npm --workspace api run sweep",
    "generate": "npm --workspace api run generate",
    "test": "npm --workspace api run test && npm --workspace web run test",
    "test:watch": "npm --workspace api run test:watch",
    "typecheck": "tsc --noEmit && npm --workspace web run check"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "concurrently": "^10.0.5",
    "typescript": "^5.9.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "prisma@7.10.0": true,
    "@prisma/client@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "better-sqlite3@12.11.1": true
  }
}
