# Copy to .env for local development.

# The port the dev server opens in the browser. Read by `vite.config.ts`.
#
# 4173 rather than Vite's default 5173: on Windows, 5173 sits inside a TCP range
# reserved by Hyper-V / WinNAT (`netsh interface ipv4 show excludedportrange
# protocol=tcp` lists 5085-5184 on this machine) and the bind is refused with
# EACCES before Vite can try another port. Any port outside those ranges works.
WEB_PORT=4173

# Where the dev proxy forwards `/api`. This is the API's origin, not the
# browser's — the browser only ever calls the path below, on this origin.
API_TARGET="http://127.0.0.1:3000"

# The path the browser uses for the API, read by `src/lib/api.ts`.
#
# Leave it as a path: the proxy makes the dev server's origin the API's origin,
# which is what lets the session cookie work with no CORS middleware. Changing it
# to the API's full URL points the browser straight at the API instead — which
# needs CORS with credentials *and* the cookie's SameSite relaxed, or the session
# will not survive a request. See the deployment note in CLAUDE.md.
VITE_API_BASE=/api
